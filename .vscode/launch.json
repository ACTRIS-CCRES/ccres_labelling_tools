{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "CLI: run-get-data-coverage-cloudnet",
            "type": "debugpy",
            "request": "launch",
            "module": "ccres_labelling_tools.coverage.cli",
            "args": "${command:pickArgs}",
            "console": "integratedTerminal"
        },
        {
            "name": "CLI: run-get-instrument-vertical-pointing",
            "type": "debugpy",
            "request": "launch",
            "module": "ccres_labelling_tools.vertical_pointing.cli",
            "args": "${command:pickArgs}",
            "console": "integratedTerminal"
        }
    ]
}
